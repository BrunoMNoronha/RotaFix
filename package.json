{
  "name": "rotafix",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/jest": "30.0.0",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-router": "~58.0.26",
    "expo-sharing": "~58.0.20",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3",
    "@react-native/jest-preset": "^0.88.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/src/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
